# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.
# Public HTTPS address of the game (used in verification / password-reset mails)
PUBLIC_URL=https://spiel.example.de
# 1 behind an HTTPS reverse proxy; 0 only for plain HTTP tests in the LAN
COOKIE_SECURE=1
# Moderator accounts (callsigns, comma-separated)
ADMIN=
# ── Outgoing mail (verification and password-reset links). Empty SMTP_HOST = links only in the server log.
# Gmail:   SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  SMTP_SECURITY=starttls
#          SMTP_USER=you@gmail.com      SMTP_PASS=<app password: myaccount.google.com/apppasswords, needs 2-step verification>
# iCloud:  SMTP_HOST=smtp.mail.me.com   SMTP_PORT=587  SMTP_SECURITY=starttls
#          SMTP_USER=you@icloud.com     SMTP_PASS=<app-specific password: account.apple.com → Sign-In and Security>
#          MAIL_FROM must be your iCloud address or an iCloud+ custom-domain address
# Other:   port 465 → SMTP_SECURITY=ssl, port 587 → starttls, port 25 in the LAN → none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
# Sender address (empty = SMTP_USER); Gmail/iCloud only accept your own address or a verified alias
MAIL_FROM=
MAIL_FROM_NAME=Tiefenkontakt
# Optional: where replies go
MAIL_REPLY_TO=
# 0 only for a LAN mail server with a self-signed certificate
SMTP_TLS_VERIFY=1
SMTP_TIMEOUT_S=20
# ── Operator alerts by mail (game server watchdog + scripts/healthcheck.sh on the host)
# Recipient (empty = MAIL_FROM); needs the SMTP settings above. ALERT=0 switches the watchdog off.
ALERT_TO=
ALERT=1
# 1 = a short "alles OK" summary every day at ALERT_DAILY_HOUR (UTC)
ALERT_DAILY=0
ALERT_DAILY_HOUR=7
# Low disk in /data: below 10 % or below 1 GB free (forms: 15%, 2GB, 500MB, 10%,1GB; 0 = off)
ALERT_DISK_MIN=10%,1GB
# RSS of the server process in MB (empty = 1024, at most half the RAM)
ALERT_RSS_MB=
# Event-loop lag p99 and match tick p95 in ms, each over ALERT_PERSIST checks in a row, every ALERT_CHECK_S s
ALERT_LAG_MS=200
ALERT_TICK_MS=50
ALERT_CHECK_S=60
ALERT_PERSIST=5
# Host health check (cron, scripts/install-health-cron.sh): failures in a row before restart + mail,
# 1 = restart the container automatically (at most HC_MAX_RESTARTS per outage), reminder mail every HC_REMIND_H h
HC_FAILS=2
HC_RESTART=1
HC_MAX_RESTARTS=3
HC_REMIND_H=6
# Weekly restore test: fail if the newest backup is older than this many hours (empty = 2 × BACKUP_EVERY_H + 1)
RESTORE_MAX_AGE_H=
# Bearer token for /api/metrics (empty = moderators only)
METRICS_TOKEN=
# Matches at the same time (lobby + running); a Pi 5 handles 30 comfortably
MAX_MATCHES=30
# Host port of the game server
HOST_PORT=8787
# Raspberry Pi with SD card: save running matches less often
MATCH_SAVE_S=30
# Backups in the data volume
BACKUP_KEEP=7
BACKUP_EVERY_H=24
# Host folder for a second copy of every backup (default ./backup-mirror); best a second disk or NAS mount
BACKUP_MIRROR_HOST=
# ── Voice radio. Without anything here, browsers talk directly (works in the LAN and behind open routers).
# Profiles: COMPOSE_PROFILES=turn (TURN relay), sfu (voice server), or turn,sfu for both.
COMPOSE_PROFILES=
# TURN relay (profile turn). TURN_SECRET: a long random string (scripts/deploy-pi.sh creates one if missing).
# Router: forward UDP+TCP 3478 and UDP 49160-49200 to the Pi.
TURN_URLS=
TURN_SECRET=
# Optional extra STUN server, e.g. stun:stun.l.google.com:19302 (a third party then sees player addresses)
STUN_URLS=
# Voice server (profile sfu): LIVEKIT_URL=/lk (through this server). Key/secret: created by deploy-pi.sh if missing.
# Router: forward TCP 7881 and UDP 7882 to the Pi. With LIVEKIT_URL set, the server enforces the radio rules.
LIVEKIT_URL=
LIVEKIT_KEY=
LIVEKIT_SECRET=
